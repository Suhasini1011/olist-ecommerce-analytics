		table fact_order_items
			lineageTag: ccbbf56a-df2f-4137-aa22-396fba34cf2a

			measure 'Item Revenue' = ```
					
					        CALCULATE ( SUM ( fact_order_items[price] ),
					            KEEPFILTERS ( NOT fact_order_items[order_status] IN { "canceled", "unavailable" } ) )
					```
				lineageTag: e87c54e9-5346-4f3b-a8d6-3a86173cf09e

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure Freight = SUM ( fact_order_items[freight_value] )
				lineageTag: 5902ba05-0dd6-4de7-b50d-90a579208c7f

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Items Sold' = COUNTROWS ( fact_order_items )
				formatString: 0
				lineageTag: a2b8495c-5b43-4aa8-82b4-bada4831331b

			measure '% of Total Revenue' = ```
					
					        DIVIDE ( [Item Revenue],
					            CALCULATE ( [Item Revenue], REMOVEFILTERS ( dim_product ), REMOVEFILTERS ( dim_seller ) ) )
					```
				lineageTag: bef870e6-f655-42af-ab0f-5a84bc16c2e4

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Revenue PY' = ```
					
					        CALCULATE ( [Item Revenue], SAMEPERIODLASTYEAR ( dim_date[date_key] ) )
					```
				lineageTag: 57f874e7-8537-415d-ac59-58ac99f7f8b8

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Revenue YoY %' = DIVIDE ( [Item Revenue] - [Revenue PY], [Revenue PY] )
				lineageTag: 9e5f4a54-b89c-4379-a4df-c4c6919fdcf9

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Revenue Running Total' = ```
					
					        VAR MaxDate = MAX ( dim_date[date_key] )
					        RETURN CALCULATE ( [Item Revenue], FILTER ( ALLSELECTED ( dim_date ), dim_date[date_key] <= MaxDate ) )
					```
				lineageTag: f29248d9-1210-407a-9731-530ef35ef395

				annotation PBI_FormatHint = {"isGeneralNumber":true}

