		table fact_orders
			lineageTag: 38920bbc-6430-4b0d-9cde-d9ed574c503e

			measure Orders = COUNTROWS ( fact_orders )
				formatString: 0
				lineageTag: f465d46f-dfcb-42e5-a429-1841896720ee

			measure 'Delivered Orders' = ```
					
					        CALCULATE ( [Orders],
					            KEEPFILTERS ( fact_orders[order_status] = "delivered" ),
					            NOT ISBLANK ( fact_orders[delivered_ts] ) )
					```
				formatString: 0
				lineageTag: aa289eed-30d8-41d4-b1ca-f6d97d1e09ac

			measure 'Late Orders' = ```
					
					        CALCULATE ( [Delivered Orders], KEEPFILTERS ( fact_orders[is_late] = TRUE () ) )
					```
				formatString: 0
				lineageTag: 3615ac9c-9f43-4afe-8d0b-e0353ba20d8a

			measure '% Late' = DIVIDE ( [Late Orders], [Delivered Orders] )
				lineageTag: 3d6f9b7d-d198-4109-9c60-d39f9eb7b5e6

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Avg Delivery Days' = ```
					
					        CALCULATE ( AVERAGE ( fact_orders[delivery_days] ),
					            KEEPFILTERS ( fact_orders[order_status] = "delivered" ) )
					```
				lineageTag: 4007a27f-a2e0-43d6-81c2-b1db19f462ae

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Reviewed Orders' = COUNT ( fact_orders[review_score] )
				formatString: 0
				lineageTag: a658c0c3-a1ae-4ecd-bc7f-2db17ada651d

			measure 'Avg Review Score' = AVERAGE ( fact_orders[review_score] )
				lineageTag: cd7df329-7923-488a-95fc-80ae0130eff4

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Low Score Orders' = ```
					
					        CALCULATE ( [Reviewed Orders], KEEPFILTERS ( fact_orders[review_score] <= 2 ) )
					```
				formatString: 0
				lineageTag: 079bf662-3497-45f9-9aca-6e4060d5a7f9

			measure '% Low Score' = DIVIDE ( [Low Score Orders], [Reviewed Orders] )
				lineageTag: 094582dc-e8ab-42e7-8c1f-880951190fcc

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Paid Value' = SUM ( fact_orders[payment_value] )
				lineageTag: 160ccc23-6462-4afb-983c-e4b766b482be

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Lost Sales' = ```
					
					        CALCULATE ( [Paid Value],
					            KEEPFILTERS ( fact_orders[order_status] IN { "canceled", "unavailable" } ) )
					```
				lineageTag: d22643d2-db7a-4d12-8aed-749a71fe11fe

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure Customers = ```
					
					        CALCULATE ( DISTINCTCOUNT ( fact_orders[customer_unique_id] ),
					            KEEPFILTERS ( NOT fact_orders[order_status] IN { "canceled", "unavailable" } ) )
					```
				formatString: 0
				lineageTag: a042e3d3-4826-4c34-971f-c379be674a00

			measure 'Repeat Customers' = ```
					
					        VAR CustomerDays =
					            CALCULATETABLE (
					                ADDCOLUMNS ( VALUES ( fact_orders[customer_unique_id] ),
					                    "@days", CALCULATE ( DISTINCTCOUNT ( fact_orders[purchase_date] ) ) ),
					                KEEPFILTERS ( NOT fact_orders[order_status] IN { "canceled", "unavailable" } ) )
					        RETURN COUNTROWS ( FILTER ( CustomerDays, [@days] > 1 ) )
					```
				formatString: 0
				lineageTag: 62c7d497-f555-4c16-8424-77ada330d397

			measure '% Repeat Customers' = DIVIDE ( [Repeat Customers], [Customers] )
				lineageTag: 39017534-a3f3-4196-8f03-0d5e864a150e

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Orders PY' = CALCULATE ( [Orders], SAMEPERIODLASTYEAR ( dim_date[date_key] ) )
				formatString: 0
				lineageTag: 1acb000c-787b-4656-bf90-293c8cc4e265

			measure 'Orders YoY %' = DIVIDE ( [Orders] - [Orders PY], [Orders PY] )
				lineageTag: f8e37c9b-d9b4-4c74-acd4-820207862f1d

				annotation PBI_FormatHint = {"isGeneralNumber":true}

